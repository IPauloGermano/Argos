# ==============================================================================
# Argos Job Hunter 2.0 - Configurações de Ambiente
# ==============================================================================
COMPOSE_PROJECT_NAME=hermes

# --- Banco de Dados e Cache ---
# Para execução local sem Docker, utilize SQLite: sqlite:///./hermes.db
# Para produção com Docker Compose: postgresql+psycopg://hermes:hermes@postgres:5432/hermes
DATABASE_URL=sqlite:///./hermes.db
REDIS_URL=redis://localhost:6379/0

# --- Servidor Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# --- Scheduler 24/7 Autônomo ---
# Habilita o agendador integrado APScheduler dentro do FastAPI
ENABLE_BUILTIN_SCHEDULER=true
DEFAULT_SEARCH_FREQUENCY_MINUTES=60
MAX_CONCURRENT_SOURCE_CRAWLS=4

# --- Conectores de Fontes (pluggable CSV) ---
# Opções disponíveis: gupy, linkedin, remoteok, vagas, ciee, greenhouse, glassdoor, remotive, getonbrd, weworkremotely, jobicy, mock
# (indeed desativado por padrão: RSS descontinuado + busca bloqueada por anti-bot)
JOB_SOURCES=gupy,linkedin,remoteok,vagas,ciee,greenhouse,remotive,getonbrd,weworkremotely,jobicy,mock
SOURCE_TIMEOUT_SECONDS=30
SOURCE_MAX_PAGES=5
SOURCE_RATE_LIMIT_DELAY_SECONDS=1.0
MOCK_JOBS_COUNT=10

# --- Browser fallback (CloakBrowser) p/ fontes com anti-bot ---
# Apenas leitura de paginas publicas (sem login/CAPTCHA). false = HTTP puro.
CLOAK_ENABLED=true
CLOAK_HEADLESS=true
CLOAK_TIMEOUT_SECONDS=45

# --- Filtros, Validação e Vagas Fantasmas ---
# Vagas com publicação superior a MAX_JOB_AGE_DAYS serão descartadas
MAX_JOB_AGE_DAYS=60
# Threshold de similaridade de texto para detecção de duplicatas (0.80 a 0.95)
DEDUPLICATION_SIMILARITY_THRESHOLD=0.88
# Nota mínima de compatibilidade (0 a 100) para acionar alertas
MINIMUM_MATCH_SCORE=70
# Se true, faz checagem HTTP HEAD/GET de link ativo (HTTP 200 vs 404/410)
VERIFY_JOB_URL_HEALTH=false

# --- Circuit Breaker ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=300

# --- Pesos do Ranking de Relevância (Soma = 1.0) ---
MATCH_WEIGHT_ROLE=0.25
MATCH_WEIGHT_SKILLS=0.30
MATCH_WEIGHT_SENIORITY=0.15
MATCH_WEIGHT_LOCATION=0.10
MATCH_WEIGHT_SALARY=0.10
MATCH_WEIGHT_OVERALL=0.10

# --- IA / LLM (Opcional - caso queira análise semântica adicional) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# --- Notificações: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=15

# --- Notificações: Discord ---
DISCORD_WEBHOOK_URL=
DISCORD_TIMEOUT_SECONDS=15

# --- Notificações: SMTP / E-mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hermes@localhost
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# --- Frontend Web Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# --- Postgres (Docker Compose) ---
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes
POSTGRES_DB=hermes
